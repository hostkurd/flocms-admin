{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true, "types": ["vite/client"]
  },
  "include": [
    "resources/js/**/*.ts",
    "vite.config.ts",
    "vite.editor.config.ts",
    "playwright.config.ts",
    "tests/Browser/**/*.ts"
  ]
}
