<?php
declare(strict_types=1);

namespace {{ namespace }};

use FloCMS\Admin\Form\Fields\TextInput;
use FloCMS\Admin\Form\Form;
use FloCMS\Admin\Resource;
use FloCMS\Admin\Table\Columns\DateColumn;
use FloCMS\Admin\Table\Columns\TextColumn;
use FloCMS\Admin\Table\Table;

final class {{ class }} extends Resource
{
    protected static string $table = '{{ table }}';

    // URL: /admin/{{ slug }}
    protected static string $slug = '{{ slug }}';

    protected static bool $timestamps = {{ timestamps }};

    protected static string $label = '{{ label }}';
    protected static string $pluralLabel = '{{ pluralLabel }}';
    protected static ?string $icon = 'list';

    // How Create and Edit open: 'page' (full page), 'modal' (dialog) or 'slide-over'
    protected static string $formMode = '{{ formMode }}';

    public function form(Form $form): Form
    {
        return $form->schema([
            TextInput::make('title')->translatable()->rules('required|max:190')->columnSpan(2),
            // Related records (see docs/relationships.md in flocms-admin):
            // \FloCMS\Admin\Form\Fields\BelongsTo::make('category_id')->resource(CategoryResource::class),
            // \FloCMS\Admin\Form\Fields\BelongsToMany::make('tags')->resource(TagResource::class)->pivot('{{ table }}_tags', 'item_id', 'tag_id'),
        ]);
    }

    public function table(Table $table): Table
    {
        return $table
            ->columns([
                TextColumn::make('id')->sortable()->toggleable(),   // ->toggleable(): listed in the Columns menu
                TextColumn::make('title')->searchable()->sortable(),{{ dateColumn }}
            ])
            ->defaultSort('id', 'desc');
    }
}
