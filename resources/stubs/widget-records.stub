<?php
declare(strict_types=1);

namespace {{ namespace }};
{{ imports }}
use FloCMS\Admin\Table\Columns\TextColumn;
use FloCMS\Admin\Widgets\RecordsWidget;
use FloCMS\Admin\Widgets\WidgetQuery;

/**
 * Dashboard table of recent records (read only, at most 20 rows).
 * Registered in config/admin.php under 'widgets'.
 */
final class {{ class }} extends RecordsWidget
{
    protected string $title = '{{ title }}'; // plain text or a site language key
    protected string $resource = {{ resource }};
    protected int $limit = 5; // 1-20
    protected string $sortColumn = 'id';
    protected string $sortDirection = 'desc';
    protected int|string $columnSpan = 1; // 1-4 or 'full'

    protected function columns(): array
    {
        // 1-8 display-safe columns of the resource's table.
        return [
            TextColumn::make('{{ column }}')->limit(70),
        ];
    }

    protected function query(WidgetQuery $query): WidgetQuery
    {
        // Narrow the rows, e.g. return $query->where('status', '=', 'published');
        return $query;
    }
}
